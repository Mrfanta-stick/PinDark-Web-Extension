{
  "manifest_version": 3,
  "name": "PinDark",
  "version": "1.0.0",
  "description": "A lightweight, reliable dark mode for Pinterest Web. Toggle on, schedule it for the evening, and never get blinded by the white feed again.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.pinterest.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PinDark",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*"
      ],
      "css": [
        "content/theme.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
